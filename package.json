{
  "name": "pickld",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "db:clean": "node -e \"const fs=require('fs');['server/data/picklestack.db','server/data/picklestack.db-wal','server/data/picklestack.db-shm'].forEach(f=>{try{fs.unlinkSync(f);console.log('Deleted',f)}catch{}})\""
  },
  "dependencies": {
    "22": "^0.0.0"
  }
}
